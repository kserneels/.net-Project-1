{
  "openapi": "3.0.1",
  "info": {
    "title": "BookReviewsApi",
    "version": "1.0"
  },
  "paths": {
    "/api/Books/AddWithReview": {
      "post": {
        "tags": [
          "Books"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookReviewDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BookReviewDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BookReviewDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/Books/Reviews": {
      "get": {
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewDisplayDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewDisplayDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewDisplayDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Books/Reviews/{id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/BookReview"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookReview"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookReview"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookReview"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BookReview"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BookReview"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "required": [
          "author",
          "isbn",
          "title",
          "year"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "author": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "year": {
            "minLength": 1,
            "pattern": "^\\d{4}$",
            "type": "string"
          },
          "isbn": {
            "minLength": 1,
            "pattern": "^\\d{10}(\\d{3})?$",
            "type": "string"
          },
          "coverUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "reviews": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookReview"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BookReview": {
        "required": [
          "rating",
          "review",
          "reviewDate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "rating": {
            "minLength": 1,
            "type": "string"
          },
          "review": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "reviewDate": {
            "type": "string",
            "format": "date-time"
          },
          "bookId": {
            "type": "integer",
            "format": "int32"
          },
          "book": {
            "$ref": "#/components/schemas/Book"
          }
        },
        "additionalProperties": false
      },
      "BookReviewDto": {
        "required": [
          "author",
          "isbn",
          "rating",
          "reviewDate",
          "title",
          "year"
        ],
        "type": "object",
        "properties": {
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "author": {
            "minLength": 1,
            "type": "string"
          },
          "year": {
            "minLength": 1,
            "type": "string"
          },
          "isbn": {
            "minLength": 1,
            "type": "string"
          },
          "coverUrl": {
            "type": "string",
            "nullable": true
          },
          "rating": {
            "minLength": 1,
            "type": "string"
          },
          "review": {
            "type": "string",
            "nullable": true
          },
          "reviewDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ReviewDisplayDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "rating": {
            "type": "string",
            "nullable": true
          },
          "review": {
            "type": "string",
            "nullable": true
          },
          "reviewDate": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "coverUrl": {
            "type": "string",
            "nullable": true
          },
          "author": {
            "type": "string",
            "nullable": true
          },
          "year": {
            "type": "string",
            "nullable": true
          },
          "isbn": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}