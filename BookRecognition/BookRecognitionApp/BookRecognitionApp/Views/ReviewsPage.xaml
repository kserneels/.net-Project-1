<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BookRecognitionApp.ViewModels"
             x:Class="BookRecognitionApp.Views.ReviewsPage"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <ContentPage.Background>
        <LinearGradientBrush>
            <GradientStop Color="#E1DCC5" Offset="0.0" />
            <GradientStop Color="#B0C4DE" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <!-- Wrap everything in a single StackLayout -->
    <StackLayout Padding="10">

        <!-- Top Row with Back Button and Label in a Grid -->
        <Grid ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <!-- Kolom voor de back-knop, krijgt een automatische breedte -->
                <ColumnDefinition Width="Auto"/>

                <!-- Kolom voor de label, neemt de resterende ruimte -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Terug-knop aan de linkerkant -->
            <Button Text="Terug naar HomePagina"
            FontSize="18"
            BackgroundColor="#D32F2F"
            TextColor="White"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            Command="{Binding BackCommand}" 
            Grid.Column="0"/>

            <!-- Centraal geplaatste label -->
            <Label Text="Mijn boek reviews"
           TextColor="#3b5998"
           FontSize="40"
           HorizontalOptions="CenterAndExpand" 
                VerticalOptions="Center"
           Grid.Column="1"/>
        </Grid>

        <!-- CollectionView for displaying reviews -->
        <CollectionView ItemsSource="{Binding Reviews}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" 
                                 Span="{OnIdiom Phone=2, Tablet=3, Desktop=5}"
                                 VerticalItemSpacing="8" 
                                 HorizontalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="4" BackgroundColor="#F2F2F2" 
                           CornerRadius="8"
                           HasShadow="True"
                           Margin="5">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReviewsPageViewModel}}, Path=NavigateToDetailCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                            <Grid HeightRequest="200" WidthRequest="150">
                                <Image Source="{Binding CoverUrl}"
                                       Aspect="AspectFill"
                                       HorizontalOptions="FillAndExpand"
                                       VerticalOptions="FillAndExpand" />

                            </Grid>
                            <Label Text="{Binding Title}" 
                                   FontSize="22" 
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="#000"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Rating}" 
                                   FontSize="20" 
                                   TextColor="Orange"
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </StackLayout>
</ContentPage>
