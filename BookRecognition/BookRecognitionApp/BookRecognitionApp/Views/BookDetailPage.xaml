<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookRecognitionApp.Views.BookDetailPage"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Title="{Binding BookReview.Title}">

    <ContentPage.Background>
        <LinearGradientBrush>
            <GradientStop Color="#E1DCC5" Offset="0.0" />
            <GradientStop Color="#B0C4DE" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False"/>
    </Shell.BackButtonBehavior>

    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="20" Spacing="15">

                <!-- Back Button with Icon -->
                <Button Text="Terug naar reviews"
                        FontSize="18"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="10,5"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Command="{Binding BackCommand}">
                    <Button.ImageSource>
                        <FontImageSource Glyph="⮐" FontFamily="OpenSansRegular" Size="20" Color="White"/>
                    </Button.ImageSource>
                </Button>

                <!-- Book Cover with Shadow -->
                <Frame HasShadow="True" Padding="0" CornerRadius="10" BackgroundColor="Transparent">
                    <Image Source="{Binding BookReview.CoverUrl, FallbackValue='Resources/Images/no_cover.jpg'}"
                           Aspect="AspectFill"
                           HeightRequest="300"
                           WidthRequest="200"
                           HorizontalOptions="Center" />
                </Frame>

                <!-- Book Title with Gradient -->
                <Grid HorizontalOptions="Center" Margin="0,15,0,5">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF6A00" Offset="0.0" />
                            <GradientStop Color="#FFD800" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Label Text="{Binding BookReview.Title}" 
           FontSize="28" 
           FontAttributes="Bold"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           TextColor="White" />
                </Grid>

                <!-- Author Name -->
                <Label Text="{Binding BookReview.Author}" 
                       FontSize="18" 
                       TextColor="#7A7A7A"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>

                <!-- Activity Indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="DarkRed" />

                <!-- Book Info Card -->
                <Frame CornerRadius="15" HasShadow="True" BackgroundColor="White" Padding="15">
                    <StackLayout Spacing="10">

                        <!-- ISBN + Buttons -->
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                            <Label Text="ISBN:" FontAttributes="Bold" FontSize="16" TextColor="#3b5998" Grid.Column="0" VerticalOptions="Center" />
                            <Label Text="{Binding BookReview.ISBN}" FontSize="16" TextColor="Black" Grid.Column="1" VerticalOptions="Center"/>
                            <StackLayout Orientation="Horizontal" Spacing="10" Grid.Column="2" HorizontalOptions="EndAndExpand">
                                <Button Text="{Binding EditButtonText}" 
                                        WidthRequest="110" 
                                        HeightRequest="40" 
                                        TextColor="White"
                                        BackgroundColor="Chocolate"
                                        Command="{Binding EditCommand}" />
                                <Button Text="Annuleren" 
                                        IsVisible="{Binding IsEditing}" 
                                        WidthRequest="110" 
                                        HeightRequest="40" 
                                        TextColor="White"
                                        BackgroundColor="#B22222"
                                        Command="{Binding CancelCommand}" />
                                <Button Text="Verwijderen" 
                                        IsVisible="{Binding IsNotEditing}" 
                                        WidthRequest="110" 
                                        HeightRequest="40" 
                                        TextColor="White"
                                        BackgroundColor="DarkRed"
                                        Command="{Binding DeleteCommand}" />
                            </StackLayout>
                        </Grid>

                        <!-- Publication Year -->
                        <Label Text="Uitgaven jaar:" FontAttributes="Bold" FontSize="16" TextColor="#3b5998"/>
                        <Label Text="{Binding BookReview.Year}" FontSize="16" TextColor="Black"/>

                        <!-- Review Date -->
                        <Label Text="Beoordeeld op" FontAttributes="Bold" FontSize="16" TextColor="#3b5998"/>
                        <Label Text="{Binding BookReview.ReviewDate, StringFormat='{0:yyyy-MM-dd}'}" FontSize="16" TextColor="Black"/>

                        <!-- Rating -->
                        <Label Text="Rating" FontSize="18" FontAttributes="Bold" TextColor="#3b5998" Margin="0,0,0,5"/>
                        <Picker SelectedItem="{Binding EditableRating}" 
                                IsVisible="{Binding IsEditing}"
                                FontSize="16" 
                                TextColor="Black" 
                                Title="Selecteer Beoordeling"
                                HorizontalOptions="FillAndExpand"
                                Margin="0,0,0,5">
                            <Picker.Items>
                                <x:String>Uitstekend</x:String>
                                <x:String>Goed</x:String>
                                <x:String>Gemiddeld</x:String>
                                <x:String>Slecht</x:String>
                            </Picker.Items>
                        </Picker>
                        <Label Text="{Binding BookReview.Rating}" 
                               IsVisible="{Binding IsNotEditing}"
                               FontSize="16" 
                               TextColor="#FFA500" 
                               FontAttributes="Bold"/>

                        <!-- Review -->
                        <Label Text="Review" FontSize="18" FontAttributes="Bold" TextColor="#3b5998" Margin="0,10,0,5"/>
                        <Editor Text="{Binding EditableReview}" 
                                IsVisible="{Binding IsEditing}"
                                FontSize="16" 
                                TextColor="Black" 
                                AutoSize="TextChanges"/>
                        <Label Text="{Binding BookReview.Review}" 
                               IsVisible="{Binding IsNotEditing}"
                               FontSize="16" 
                               TextColor="Black" 
                               LineBreakMode="WordWrap"/>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
